# CLIProxyAPI (primary provider, optional)
# Local dev: http://localhost:8317 | Render: public tunnel URL
CLIPROXY_BASE_URL=http://localhost:8317
CLIPROXY_API_KEY=your-cliproxy-api-key
CLIPROXY_MODEL=claude-haiku-5-5

# Groq API Key (fallback when CLIProxyAPI is unreachable)
GROQ_API_KEY=your-groq-api-key

# Server port (must match the /api proxy target in vite.config.ts)
PORT=3002
