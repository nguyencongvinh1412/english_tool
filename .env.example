# CLIProxyAPI (primary AI provider, optional)
# Local dev: http://localhost:8317 | Docker: overridden to http://host.docker.internal:8317
CLIPROXY_BASE_URL=http://localhost:8317
CLIPROXY_API_KEY=your-cliproxy-api-key
CLIPROXY_MODEL=claude-haiku-5-5

# Groq API Key (fallback when CLIProxyAPI is unreachable)
GROQ_API_KEY=your-groq-api-key

# Server port (must match the /api proxy target in vite.config.ts)
PORT=3002

# Database (docker compose service "db"; the app container overrides the host)
DB_PASSWORD=change-me
DATABASE_URL=postgres://english:change-me@localhost:5433/english_tool
DATABASE_URL_TEST=postgres://english:change-me@localhost:5433/english_tool_test

# Bootstrap admin (created on first start if no admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# AI access for learners
LEARNER_DAILY_AI_LIMIT=100
LEARNER_MODELS=claude-haiku-5-5,gemini-3-flash,claude-sonnet-5-5

# Kokoro text-to-speech (docker compose service "tts"); leave empty to use browser voices only
TTS_BASE_URL=http://localhost:8880

# Extra origins allowed to make state-changing requests (comma-separated), e.g. a tunnel URL
APP_ORIGIN=

# ---------------------------------------------------------------------------------------------
# Deployment (see DEPLOY.md). Leave empty for local use.

# Supabase: direct or session-pooler URL used only for migrations
DATABASE_MIGRATION_URL=

# File storage: local (Docker volume) or s3 (Supabase Storage S3 API)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cloudflare Access service token the app sends to the tunnelled AI proxy and Kokoro
UPSTREAM_ACCESS_CLIENT_ID=
UPSTREAM_ACCESS_CLIENT_SECRET=

# Reverse proxies in front of the app (Render: 1)
TRUST_PROXY_HOPS=1

# Token of the Cloudflare Tunnel running on this Mac (docker compose --profile tunnel up -d tunnel)
TUNNEL_TOKEN=

# Plans and AI source (optional). Admins switch between the proxy and the official APIs in Admin → Plans.
# SETTINGS_SECRET (16+ characters) encrypts API keys saved in the app; without it use the two key variables below.
SETTINGS_SECRET=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Token for a protected voice server, e.g. a private Hugging Face Space (an hf_ access token with read access)
TTS_API_TOKEN=
