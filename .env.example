# CLIProxyAPI (primary AI provider, optional)
# Local dev: http://localhost:8317 | Docker: overridden to http://host.docker.internal:8317
CLIPROXY_BASE_URL=http://localhost:8317
CLIPROXY_API_KEY=your-cliproxy-api-key
CLIPROXY_MODEL=claude-haiku-5-5

# Groq API Key (fallback when CLIProxyAPI is unreachable)
GROQ_API_KEY=your-groq-api-key

# Server port (must match the /api proxy target in vite.config.ts)
PORT=3002

# Database (docker compose service "db"; the app container overrides the host)
DB_PASSWORD=change-me
DATABASE_URL=postgres://english:change-me@localhost:5433/english_tool
DATABASE_URL_TEST=postgres://english:change-me@localhost:5433/english_tool_test

# Bootstrap admin (created on first start if no admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# AI access for learners
LEARNER_DAILY_AI_LIMIT=100
LEARNER_MODELS=claude-haiku-5-5,gemini-3-flash,gpt-5.5

# Kokoro text-to-speech (docker compose service "tts"); leave empty to use browser voices only
TTS_BASE_URL=http://localhost:8880

# Extra origins allowed to make state-changing requests (comma-separated), e.g. a tunnel URL
APP_ORIGIN=
